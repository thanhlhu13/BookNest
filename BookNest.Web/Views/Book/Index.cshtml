@model BookNest.Application.DTOs.Common.PagedResultDto<BookNest.Application.DTOs.Book.BookDto>

@{
    ViewData["Title"] = "Book Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Book Management</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Add Book
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    var query = ViewBag.Query as BookNest.Application.DTOs.Book.BookQueryDto;
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <input type="text"
                           name="SearchTerm"
                           value="@query?.SearchTerm"
                           class="form-control"
                           placeholder="Search by title or ISBN..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select name="CategoryId" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var category in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Categories)
                        {
                            <option value="@category.Value"
                                    selected="@(query?.CategoryId?.ToString() == category.Value)">
                                @category.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="IsActive" class="form-select">
                        <option value="">All Status</option>
                        <option value="true" selected="@(query?.IsActive == true)">Active</option>
                        <option value="false" selected="@(query?.IsActive == false)">Inactive</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Sort By</label>
                    <select name="SortBy" class="form-select">
                        <option value="title" selected="@(query?.SortBy == "title")">Title</option>
                        <option value="isbn" selected="@(query?.SortBy == "isbn")">ISBN</option>
                        <option value="publisher" selected="@(query?.SortBy == "publisher")">Publisher</option>
                        <option value="createdAt" selected="@(query?.SortBy == "createdAt")">Created Date</option>
                        <option value="publishedDate" selected="@(query?.SortBy == "publishedDate")">Published Date</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Sort Direction</label>
                    <select name="SortDirection" class="form-select">
                        <option value="asc"
                                selected="@(query?.SortDirection == "asc")">
                            Ascending
                        </option>
                        <option value="desc"
                                selected="@(query?.SortDirection == "desc")">
                            Descending
                        </option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Page Size</label>
                    <select name="PageSize" class="form-select">
                        <option value="5" selected="@(query?.PageSize == 5)">5</option>
                        <option value="10" selected="@(query?.PageSize == 10)">10</option>
                        <option value="20" selected="@(query?.PageSize == 20)">20</option>
                        <option value="50" selected="@(query?.PageSize == 50)">50</option>
                        <option value="100" selected="@(query?.PageSize == 100)">100</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Search
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Cover</th>
                            <th>Title</th>
                            <th>ISBN</th>
                            <th>Category</th>
                            <th>Publisher</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Items)
                        {
                            <tr>
                                <td>@book.Id</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(book.CoverImageUrl))
                                    {
                                        <img src="@book.CoverImageUrl"
                                             alt="@book.Title"
                                             class="rounded"
                                             style="width: 50px; height: 65px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                                <td class="fw-semibold">@book.Title</td>
                                <td>@book.ISBN</td>
                                <td>@book.CategoryName</td>
                                <td>@(book.Publisher ?? "-")</td>
                                <td>
                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details"
                                       asp-route-id="@book.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@book.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@book.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this book?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="text-muted">
                    Showing @Model.Items.Count() of @Model.TotalCount books
                    | Page @Model.PageNumber of @Model.TotalPages
                </div>

                <div class="d-flex gap-2">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-action="Index"
                           asp-route-SearchTerm="@query?.SearchTerm"
                           asp-route-CategoryId="@query?.CategoryId"
                           asp-route-IsActive="@query?.IsActive"
                           asp-route-SortBy="@query?.SortBy"
                           asp-route-SortDirection="@query?.SortDirection"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-PageSize="@Model.PageSize"
                           class="btn btn-outline-primary btn-sm">
                            Previous
                        </a>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-SearchTerm="@query?.SearchTerm"
                           asp-route-CategoryId="@query?.CategoryId"
                           asp-route-IsActive="@query?.IsActive"
                           asp-route-SortBy="@query?.SortBy"
                           asp-route-SortDirection="@query?.SortDirection"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-PageSize="@Model.PageSize"
                           class="btn btn-outline-primary btn-sm">
                            Next
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5 class="text-muted">No books found.</h5>
                <p class="text-muted mb-0">
                    Start by adding your first book.
                </p>
            </div>
        }
    </div>
</div>
