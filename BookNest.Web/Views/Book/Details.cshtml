
@model BookNest.Application.DTOs.Book.BookDto

@{
    ViewData["Title"] = "Book Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Book Details</h2>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h3 class="mb-3">@Model.Title</h3>

                <dl class="row">
                    <dt class="col-sm-4">Book ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>

                    <dt class="col-sm-4">Publisher</dt>
                    <dd class="col-sm-8">@(Model.Publisher ?? "-")</dd>

                    <dt class="col-sm-4">Published Date</dt>
                    <dd class="col-sm-8">
                        @(Model.PublishedDate?.ToString("dd/MM/yyyy") ?? "-")
                    </dd>

                    <dt class="col-sm-4">Language</dt>
                    <dd class="col-sm-8">@(Model.Language ?? "-")</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">
                        @(Model.Description ?? "-")
                    </dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Created At</dt>
                    <dd class="col-sm-8">
                        @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-4">Updated At</dt>
                    <dd class="col-sm-8">
                        @(Model.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                    </dd>
                </dl>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Edit Book
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
